<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCBuddy.Views.SystemInfoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PCBuddy.ViewModels"
    mc:Ignorable="d"
    d:DesignHeight="700" d:DesignWidth="900"
    Background="#FF121812">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="24">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" 
                        Background="Transparent" BorderThickness="0" Foreground="White"
                        Click="BackButton_Click" Padding="8"/>
                <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Details}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid Visibility="{Binding IsHeader, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" 
                                           Foreground="#B7B9B5" 
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Visibility="{Binding Label, Converter={StaticResource StringToVisibilityConverter}}"/>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding Value}" 
                                           Foreground="White" 
                                           FontSize="14"
                                           TextWrapping="Wrap"/>
                            </Grid>
                            <TextBlock Text="{Binding Label}" 
                                       Foreground="White" 
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0,12,0,4"
                                       Visibility="{Binding IsHeader, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
